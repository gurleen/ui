{
  "name": "playground",
  "version": "0.1.0",
  "private": true,
  "description": "Visual demo app for @hydra-tv/ui, @hydra-tv/broadcast and @hydra-tv/sports: a kitchen-sink of every component plus the broadcast and sports-analytics reference screens rebuilt as real composed React.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@hydra-tv/broadcast": "0.2.0",
    "@hydra-tv/sports": "0.2.0",
    "@hydra-tv/ui": "0.2.0",
    "@hydra-tv/tokens": "0.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "wrangler": "^3.99.0"
  }
}
