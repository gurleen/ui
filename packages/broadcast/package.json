{
  "name": "@hydra-tv/broadcast",
  "version": "0.3.3",
  "description": "Broadcast-TV control-room components (tally lamps, timecode, transport controls, VU meters, macro keys) built on @hydra-tv/ui and @hydra-tv/tokens.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "src/components/*.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {
    "@hydra-tv/ui": "0.3.4",
    "@hydra-tv/tokens": "0.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gurleen/ui.git",
    "directory": "packages/broadcast"
  },
  "bugs": {
    "url": "https://github.com/gurleen/ui/issues"
  },
  "homepage": "https://github.com/gurleen/ui/tree/main/packages/broadcast#readme",
  "keywords": [
    "react",
    "broadcast",
    "control-room",
    "hydra-tv",
    "tally",
    "timecode"
  ]
}
