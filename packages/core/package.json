{
  "name": "@hydra-tv/ui",
  "version": "0.3.0",
  "description": "Generic, domain-agnostic React components for the @hydra-tv design system (buttons, inputs, dialogs, data grids, etc.). No broadcast-specific semantics — see @hydra-tv/broadcast for those.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "src/components/*.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {
    "@hydra-tv/tokens": "0.2.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gurleen/ui.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/gurleen/ui/issues"
  },
  "homepage": "https://github.com/gurleen/ui/tree/main/packages/core#readme",
  "keywords": [
    "react",
    "components",
    "design-system",
    "hydra-tv",
    "dark-theme"
  ]
}
