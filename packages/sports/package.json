{
  "name": "@hydra-tv/sports",
  "version": "0.3.3",
  "description": "Sports analytics components (scoreboards, box scores, shot charts, strike zones, spray charts) for basketball and baseball, built on @hydra-tv/ui and @hydra-tv/tokens.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "src/components/*.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {
    "@hydra-tv/tokens": "0.3.0",
    "@hydra-tv/ui": "0.3.2",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.185.4",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gurleen/ui.git",
    "directory": "packages/sports"
  },
  "bugs": {
    "url": "https://github.com/gurleen/ui/issues"
  },
  "homepage": "https://github.com/gurleen/ui/tree/main/packages/sports#readme",
  "keywords": [
    "react",
    "sports",
    "analytics",
    "hydra-tv",
    "basketball",
    "baseball",
    "shot-chart",
    "strike-zone"
  ]
}
